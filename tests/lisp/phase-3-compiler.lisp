;;; phase-3-compiler.lisp -- the language-behavior checks of tests/phase-3-compiler.st,
;;; moved to cog-lisp (Phase 8 step 8.1; generated by tests/lisp/convert-suites.py).
;;; Test names keep their spec references (AC-n, review ids).
(load "../../lib/test.lisp")

(define-test "AC-1 42"
  (check (eval-all "42") 42))
(define-test "AC-1 string"
  (check (eval-all "\"hi\"") "hi"))
(define-test "AC-1 #t"
  (check (eval-all "#t") #t))
(define-test "AC-1 #\\a"
  (check (eval-all "#\\a") #\a))
(define-test "AC-1 ()"
  (check () '()))
(define-test "AC-2 (quote x)"
  (check (quote x) 'x))
(define-test "AC-2 'x"
  (check (eval-all "'x") 'x))
(define-test "AC-3 '(1 2 3)"
  (check (eval-all "'(1 2 3)") '(1 2 3)))
(define-test "AC-3 '(1 . 2)"
  (check (eval-all "'(1 . 2)") '(1 . 2)))
(define-test "AC-4 global read"
  (check (eval-all "(define x 5) x") 5))
(define-test "AC-5 unbound read signals"
  (check-error (eval-all "nosuchvar")))
(define-test "AC-6 (if #t 1 2)"
  (check (if #t 1 2) 1))
(define-test "AC-6 (if #f 1 2)"
  (check (if #f 1 2) 2))
(define-test "AC-6 (if 0 1 2) [0 truthy]"
  (check (if 0 1 2) 1))
(define-test "AC-7 (if #f 1) unspecified"
  (check (if #f 1) (if #f #f)))
(define-test "AC-8 (begin 1 2 3)"
  (check (begin 1 2 3) 3))
(define-test "AC-8 begin order"
  (check (eval-all "(define c 0) (begin (set! c 1) (set! c (+ c 10)) c)") 11))
(define-test "AC-9 ((lambda (x) x) 5)"
  (check ((lambda (x) x) 5) 5))
(define-test "AC-10 ((lambda (x y) (+ x y)) 2 3)"
  (check ((lambda (x y) (+ x y)) 2 3) 5))
(define-test "AC-12 closure capture"
  (check (((lambda (x) (lambda (y) (+ x y))) 2) 3) 5))
(define-test "AC-13 let"
  (check (let ((x 1) (y 2)) (+ x y)) 3))
(define-test "AC-14 let shadowing"
  (check (let ((x 1)) (let ((x 2)) x)) 2))
(define-test "AC-15 define value"
  (check (eval-all "(define y 10) y") 10))
(define-test "AC-16 define fn sugar"
  (check (eval-all "(define (sq n) (* n n)) (sq 4)") 16))
(define-test "AC-17 global set!"
  (check (eval-all "(define z 1) (set! z 2) z") 2))
(define-test "AC-17 set! unbound signals"
  (check-error (eval-all "(set! nope 5)")))
(define-test "AC-18 local set!"
  (check (eval-all "((lambda (x) (set! x (+ x 1)) x) 10)") 11))
(define-test "AC-19 (fact 5)=120"
  (check (eval-all "(define (fact n) (if (= n 0) 1 (* n (fact (- n 1))))) (fact 5)") 120))
(define-test "AC-20 evalAll last"
  (check (eval-all "(define a 7) (+ a 1)") 8))

(run-tests)
