;;; phase-4-runtime.lisp -- the language-behavior checks of tests/phase-4-runtime.st,
;;; moved to cog-lisp (Phase 8 step 8.1; generated by tests/lisp/convert-suites.py).
;;; Test names keep their spec references (AC-n, review ids).
(load "../../lib/test.lisp")

(define-test "AC-1 procedure? of lambda"
  (check (procedure? (lambda (x) x)) #t))
(define-test "AC-2 fixed arity call"
  (check ((lambda (x y) (+ x y)) 2 3) 5))
(define-test "AC-2 wrong count signals LispArityError"
  (check-error-class (eval-all "((lambda (x y) x) 1)") LispArityError))
(define-test "AC-3 (lambda args args)"
  (check ((lambda args args) 1 2 3) '(1 2 3)))
(define-test "AC-3 (lambda (a . r) r)"
  (check ((lambda (a . r) r) 1 2 3) '(2 3)))
(define-test "AC-3 empty rest"
  (check ((lambda (a . r) r) 9) '()))
(define-test "AC-3 too few for variadic signals"
  (check-error-class (eval-all "((lambda (a b . r) r) 1)") LispArityError))
(define-test "AC-4 variadic define"
  (check (eval-all "(define (f a . rest) rest) (f 1 2 3)") '(2 3)))
(define-test "AC-5 car of cons"
  (check (car (cons 1 2)) 1))
(define-test "AC-5 cdr of cons"
  (check (cdr (cons 1 2)) 2))
(define-test "AC-6 list"
  (check (list 1 2 3) '(1 2 3)))
(define-test "AC-6 length"
  (check (length (list 1 2 3)) 3))
(define-test "AC-6 null? of (list)"
  (check (null? (list)) #t))
(define-test "AC-7 append"
  (check (append '(1 2) '(3 4)) '(1 2 3 4)))
(define-test "AC-7 reverse"
  (check (reverse '(1 2 3)) '(3 2 1)))
(define-test "AC-8 set-car"
  (check (eval-all "(define p (cons 1 2)) (set-car! p 10) p") '(10 . 2)))
(define-test "AC-8 set-cdr"
  (check (eval-all "(define q (cons 1 2)) (set-cdr! q 20) q") '(1 . 20)))
(define-test "AC-9 map square"
  (check (map (lambda (x) (* x x)) '(1 2 3)) '(1 4 9)))
(define-test "AC-10 (+ 1 2 3)"
  (check (+ 1 2 3) 6))
(define-test "AC-10 (+)"
  (check (+) 0))
(define-test "AC-10 (* 2 3 4)"
  (check (* 2 3 4) 24))
(define-test "AC-10 (*)"
  (check (*) 1))
(define-test "AC-11 (- 5)"
  (check (- 5) -5))
(define-test "AC-11 (- 10 3 2)"
  (check (- 10 3 2) 5))
(define-test "AC-12 (< 1 2 3)"
  (check (< 1 2 3) #t))
(define-test "AC-12 (< 1 3 2)"
  (check (< 1 3 2) #f))
(define-test "AC-12 (= 2 2 2)"
  (check (= 2 2 2) #t))
(define-test "AC-13 (modulo 7 3)"
  (check (modulo 7 3) 1))
(define-test "AC-13 (quotient 7 2)"
  (check (quotient 7 2) 3))
(define-test "AC-13 (zero? 0)"
  (check (zero? 0) #t))
(define-test "AC-14 equal? lists"
  (check (equal? '(1 2) '(1 2)) #t))
(define-test "AC-14 eq? symbols"
  (check (eq? 'a 'a) #t))
(define-test "AC-14 (not #f)"
  (check (not #f) #t))
(define-test "AC-14 (not 0)"
  (check (not 0) #f))
(define-test "AC-15 number?"
  (check (number? 3) #t))
(define-test "AC-15 symbol?"
  (check (symbol? 'x) #t))
(define-test "AC-15 procedure? car"
  (check (procedure? car) #t))
(define-test "AC-16 (apply + (list 1 2 3))"
  (check (apply + (list 1 2 3)) 6))
(define-test "AC-17 (5 6) signals LispError"
  (check-error (eval-all "(5 6)")))
(define-test "AC-18 (sum (1 2 3 4 5)) = 15"
  (check (eval-all "(define (sum lst) (if (null? lst) 0 (+ (car lst) (sum (cdr lst))))) (sum '(1 2 3 4 5))") 15))
(define-test "AC-19 compose = 25"
  (check (eval-all "(define (compose f g) (lambda (x) (f (g x)))) ((compose (lambda (x) (* x x)) (lambda (x) (+ x 1))) 4)") 25))
(define-test "AC-20 fact 5"
  (check (eval-all "(define (fact n) (if (= n 0) 1 (* n (fact (- n 1))))) (fact 5)") 120))
(define-test "AC-20 closure capture"
  (check (((lambda (x) (lambda (y) (+ x y))) 2) 3) 5))

(run-tests)
