;;; phase-7.7-conditions.lisp -- the language-behavior checks of tests/phase-7.7-conditions.st,
;;; moved to cog-lisp (Phase 8 step 8.1; generated by tests/lisp/convert-suites.py).
;;; Test names keep their spec references (AC-n, review ids).
(load "../../lib/test.lisp")

(define-test "AC-1 message and written irritants"
  (check-error (eval-all "(error \"bad size:\" 5 (quote x) \"s\")") "bad size: 5 x \"s\""))
(define-test "AC-1 accessors"
  (check (guard (e (#t (list (error-object? e) (error-object-message e) (error-object-irritants e)))) (error "bad size:" 5 (quote x))) '(#t "bad size:" (5 x))))
(define-test "AC-1 no irritants"
  (check (guard (e (#t (error-object-irritants e))) (error "plain")) '()))
(define-test "AC-2 a raised symbol"
  (check (guard (e ((symbol? e) e)) (raise (quote oops))) 'oops))
(define-test "AC-2 a raised list"
  (check (guard (e ((pair? e) (car e))) (raise (list 1 2))) 1))
(define-test "AC-2 car of a number"
  (check (guard (e ((error-object? e) (error-object-message e))) (car 5)) "car: not a pair: 5"))
(define-test "AC-2 division by zero"
  (check (guard (e ((error-object? e) (error-object-message e))) (/ 1 0)) "division by zero"))
(define-test "AC-2 a send not understood"
  (check (guard (e ((error-object? e) (error-object-message e))) [3 frobnicate]) "3 does not understand #frobnicate"))
(define-test "AC-2 =>"
  (check (guard (e ((assq (quote a) e) => cdr)) (raise (list (cons (quote a) 42)))) 42))
(define-test "AC-2 else"
  (check (guard (e ((string? e) 1) (else 2)) (raise 3)) 2))
(define-test "AC-2 no matching clause reaches the outer guard"
  (check (guard (o (#t (list (quote outer) o))) (guard (i ((string? i) (quote inner))) (raise 7))) '(outer 7)))
(define-test "AC-2 uncaught, a raise is reported"
  (check-error (eval-all "(raise (list 1 2))") "uncaught raise: (1 2)"))
(define-test "AC-3 the body's value when nothing is raised"
  (check (guard (e (#t 0)) (+ 1 2)) 3))
(define-test "AC-3 the innermost guard catches first"
  (check (guard (o (#t (quote outer))) (guard (i (#t (quote inner))) (raise 1))) 'inner))
(define-test "AC-4 raise-continuable resumes with the handler's value"
  (check (with-exception-handler (lambda (c) 10) (lambda () (+ 1 (raise-continuable (quote need))))) 11))
(define-test "AC-4 the handler runs before unwinding: dynamic-wind after has not run"
  (check (eval-all "(define w4 (list)) (with-exception-handler (lambda (c) (set! w4 (cons (quote handler) w4)) 0) (lambda () (dynamic-wind (lambda () #f) (lambda () (raise-continuable 1)) (lambda () (set! w4 (cons (quote after) w4)))))) (reverse w4)") '(handler after)))
(define-test "AC-4 returning from a plain raise is an error"
  (check-error (eval-all "(with-exception-handler (lambda (c) 1) (lambda () (raise (quote x))))") "handler returned from a non-continuable raise"))
(define-test "AC-4 a raise in the handler goes to the next handler out"
  (check (guard (e (#t (list (quote outer) e))) (with-exception-handler (lambda (c) (raise (quote from-handler))) (lambda () (raise (quote first))))) '(outer from-handler)))
(define-test "AC-5 condition?"
  (check (list (guard (e (#t (condition? e))) (car 5)) (condition? 5) (guard (e (#t (condition? e))) (raise 5))) '(#t #f #f)))
(define-test "AC-5 read-error?"
  (check (guard (e (#t (read-error? e))) (eval [(smalltalk LispReader) read: "(1 2"])) #t))
(define-test "AC-5 file-error?"
  (check (eval-all "(guard (e (#t (file-error? e))) (load \"no-such-file.lisp\"))") #t))
(define-test "AC-5 condition-report"
  (check (guard (e (#t (condition-report e))) (error "bad:" 1 2)) "bad: 1 2"))
(define-test "AC-7 normal exit"
  (check (eval-all "(define w7 (list)) (dynamic-wind (lambda () (set! w7 (cons 1 w7))) (lambda () (set! w7 (cons 2 w7))) (lambda () (set! w7 (cons 3 w7)))) (reverse w7)") '(1 2 3)))
(define-test "AC-7 an error unwinding to a guard: after runs before the clause"
  (check (eval-all "(define w7b (list)) (guard (e (#t (reverse w7b))) (dynamic-wind (lambda () (set! w7b (cons (quote before) w7b))) (lambda () (error \"x\")) (lambda () (set! w7b (cons (quote after) w7b)))))") '(before after)))
(define-test "AC-7 a restart unwinding through it"
  (check (eval-all "(define w7c (list)) (restart-case (dynamic-wind (lambda () #f) (lambda () (invoke-restart (quote out) 9)) (lambda () (set! w7c (cons (quote after) w7c)))) (out (v) (list v w7c)))") '(9 (after))))
(define-test "AC-8 a restart from a handler gives the restart-case its value"
  (check (restart-case (+ 1 (with-exception-handler (lambda (c) (invoke-restart (quote use-value) 41)) (lambda () (error "boom")))) (use-value (v) v)) 41))
(define-test "AC-8 several arguments"
  (check (restart-case (invoke-restart (quote both) 3 4) (both (a b) (* a b))) 12))
(define-test "AC-8 no restart invoked: the form's value"
  (check (restart-case (+ 2 3) (never () 0)) 5))
(define-test "AC-8 the restart body runs after unwinding (its own restarts are gone)"
  (check (restart-case (invoke-restart (quote r)) (r () (find-restart (quote r)))) #f))
(define-test "AC-9 find-restart"
  (check (restart-case (restart-name (find-restart (quote here))) (here () 0)) 'here))
(define-test "AC-9 find-restart of none"
  (check (find-restart (quote nope)) #f))
(define-test "AC-9 invoke-restart of an inactive restart"
  (check-error (eval-all "(invoke-restart (quote nope))") "invoke-restart: no active restart named nope"))
(define-test "AC-9 a restart object, used after its restart-case ended"
  (check-error (eval-all "(define saved (restart-case (find-restart (quote gone)) (gone () 0))) (invoke-restart saved)") "invoke-restart: restart is not active: gone"))
(define-test "AC-10 through on: Error do: and ensure:"
  (check (eval-all "(define w10 (list)) (restart-case [(lambda () [(lambda () (invoke-restart (quote out) 1)) ensure: (lambda () (set! w10 (cons (quote ensured) w10)))]) on: (smalltalk Error) do: (lambda (e) (quote intercepted))] (out (v) (list v w10)))") '(1 (ensured))))
(define-test "AC-11 use-value"
  (check (with-exception-handler (lambda (c) (use-value 0)) (lambda () (+ unbound-a 1))) 1))
(define-test "AC-11 store-value"
  (check (with-exception-handler (lambda (c) (store-value 5)) (lambda () (+ unbound-b 1))) 6))
(define-test "AC-11 ... defines the global"
  (check (eval-all "unbound-b") 5))
(define-test "setup (from a check that stays in the suite)"
  (guard (e (#t #f)) (eval-all "(load \"../../lib/cl.lisp\")")))
(define-test "AC-16 handler-case by type"
  (check (list (handler-case (/ 1 0) (ZeroDivide (c) (quote zd))) (handler-case (car 5) (error (c) (quote err))) (handler-case (raise 1) (t (c) c))) '(zd err 1)))
(define-test "AC-16 handler-case with no matching type passes it on"
  (check (handler-case (handler-case (car 5) (ZeroDivide () (quote zd))) (error () (quote outer))) 'outer))
(define-test "AC-16 handler-bind declines by returning, then an outer handler acts"
  (check (eval-all "(defvar seen16 nil) (handler-case (handler-bind ((error (lambda (c) (push (quote saw) seen16)))) (car 5)) (error () (list (quote outer) seen16)))") '(outer (saw))))
(define-test "AC-16 handler-bind choosing a restart"
  (check (handler-bind ((error (lambda (c) (invoke-restart (quote use-value) -1)))) (restart-case (error "x") (use-value (v) v))) -1))
(define-test "AC-16 ignore-errors"
  (check (list (ignore-errors (car 5)) (ignore-errors 7)) '(() 7)))
(define-test "AC-16 unwind-protect"
  (check (eval-all "(defvar log16 nil) (ignore-errors (unwind-protect (error \"x\") (push (quote cleanup) log16))) log16") '(cleanup)))

(run-tests)
