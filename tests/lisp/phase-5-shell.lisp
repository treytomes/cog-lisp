;;; phase-5-shell.lisp -- the language-behavior checks of tests/phase-5-shell.st,
;;; moved to cog-lisp (Phase 8 step 8.1; generated by tests/lisp/convert-suites.py).
;;; Test names keep their spec references (AC-n, review ids).
(load "../../lib/test.lisp")

(define-test "setup (from a check that stays in the suite)"
  (guard (e (#t #f)) (eval-all "(define y 1)")))
(define-test "setup (from a check that stays in the suite)"
  (guard (e (#t #f)) (eval-all "(define z 1) (set! z 2)")))
(define-test "AC-17 bind and compare"
  (check (eval-all "(define u (if #f #f)) (eq? u (if #f #f))") #t))
(define-test "AC-17 unspecified is truthy"
  (check (if (if #f #f) 1 2) 1))
(define-test "AC-17 unbound still raises LispUnboundError"
  (check-error-class (eval-all "never-defined-anywhere") LispUnboundError))
(define-test "AC-15 load of a missing file raises"
  (check-error (eval-all "(load \"no/such/file.lisp\")")))
(define-test "setup"
  (eval-all "(define (sq n) (* n n))"))
(define-test "AC-19 an anonymous lambda keeps its own text"
  (check (eval-all "(procedure-source (lambda (x)   (+ x 1)))") "(lambda (x)   (+ x 1))"))
(define-test "AC-19 a nested lambda keeps its own text"
  (check (eval-all "(define (adder n) (lambda (x) (+ x n))) (procedure-source (adder 1))") "(lambda (x) (+ x n))"))
(define-test "AC-19 value-form define keeps the lambda text"
  (check (eval-all "(define f (lambda (a) a)) (procedure-source f)") "(lambda (a) a)"))
(define-test "AC-20 primitives have no source"
  (check (eval-all "(procedure-source car)") #f))
(define-test "AC-20 source text is a string"
  (check (eval-all "(string? (procedure-source (lambda () 1)))") #t))

(run-tests)
