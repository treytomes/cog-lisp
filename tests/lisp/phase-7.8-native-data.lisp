;;; phase-7.8-native-data.lisp -- the language-behavior checks of tests/phase-7.8-native-data.st,
;;; moved to cog-lisp (Phase 8 step 8.1; generated by tests/lisp/convert-suites.py).
;;; Test names keep their spec references (AC-n, review ids).
(load "../../lib/test.lisp")

(define-test "AC-1 char->integer, integer->char (lambda)"
  (check-written (list (char->integer #\A) (char->integer (integer->char 955)) (char? (integer->char 955))) "(65 955 #t)"))
(define-test "AC-1 comparisons, chained"
  (check-written (list (char<? #\a #\b #\c) (char<? #\a #\c #\b) (char=? #\x #\x) (char-ci=? #\A #\a) (char>=? #\b #\a)) "(#t #f #t #t #t)"))
(define-test "AC-1 classes"
  (check-written (list (char-alphabetic? #\a) (char-numeric? #\7) (char-whitespace? #\space) (char-upper-case? #\A) (char-lower-case? #\A)) "(#t #t #t #t #f)"))
(define-test "AC-1 case and digits"
  (check-written (list (char-upcase #\a) (char-downcase #\B) (digit-value #\7) (digit-value #\x)) "(#\\A #\\b 7 #f)"))
(define-test "AC-2 make-string, string, length, ref"
  (check-written (list (make-string 3 #\z) (string #\a #\b) (string-length "hello") (string-ref "hello" 1)) "(\"zzz\" \"ab\" 5 #\\e)"))
(define-test "AC-2 substring and string-copy with optional ranges"
  (check-written (list (substring "hello" 1 3) (substring "hello" 2) (string-copy "hello" 1 2) (string-copy "hi")) "(\"el\" \"llo\" \"e\" \"hi\")"))
(define-test "AC-2 append, ->list, list->"
  (check-written (list (string-append "a" "b" "c") (string->list "abc" 1) (list->string (list #\x #\y)) (string-append)) "(\"abc\" (#\\b #\\c) \"xy\" \"\")"))
(define-test "AC-2 symbols"
  (check-written (list (eq? (string->symbol "foo") (quote foo)) (symbol->string (quote bar))) "(#t \"bar\")"))
(define-test "AC-2 comparisons"
  (check-written (list (string=? "a" "a" "a") (string<? "apple" "banana") (string<? "b" "a") (string>? "b" "a") (string<=? "a" "a") (string-ci=? "AbC" "aBc") (string<? "Z" "a")) "(#t #t #f #t #t #t #t)"))
(define-test "AC-2 conveniences"
  (check-written (list (string-upcase "ab") (string-index "hello" #\l) (string-index "hello" #\z) (string-search "hello" "lo") (string-split "a,,b" #\,) (string-join (list "x" "y") "+") (string-trim "  t  ")) "(\"AB\" 2 #f 3 (\"a\" \"\" \"b\") \"x+y\" \"t\")"))
(define-test "AC-2 number->string"
  (check-written (list (number->string 42) (number->string 255 16) (number->string 2.5)) "(\"42\" \"ff\" \"2.5\")"))
(define-test "AC-3 string-set! on a made string"
  (check-written (let ((s (make-string 3 #\a))) (string-set! s 1 #\b) s) "\"aba\""))
(define-test "AC-3 a wide character into a byte string"
  (check-written (let ((s (string-copy "abc"))) (string-set! s 0 (integer->char 955)) (list (char->integer (string-ref s 0)) (string-length s) (string-ref s 1))) "(955 3 #\\b)"))
(define-test "AC-3 fill! and copy!"
  (check-written (let ((s (make-string 4 #\-)) (t (make-string 3 #\.))) (string-copy! s 1 "xy") (string-fill! t #\o) (list s t)) "(\"-xy-\" \"ooo\")"))
(define-test "AC-3 string-set! on a literal is an error"
  (check-error (eval-all "(string-set! \"lit\" 0 #\\x)") "string-set!: string is immutable (a literal); copy it first"))
(define-test "AC-4 numbers and not"
  (check-written (list (string->number "42") (string->number "-7") (string->number "2.5") (string->number "1e3") (string->number "x") (string->number "") (string->number "1 2") (string->number "ff" 16) (string->number "-101" 2) (string->number "9" 8)) "(42 -7 2.5 1000.0 #f #f #f 255 -5 #f)"))
(define-test "AC-5 self-evaluating, quoted or not"
  (check-written (list #(1 2) (quote #(a b)) #()) "(#(1 2) #(a b) #())"))
(define-test "AC-5 equal? and eqv?"
  (check-written (list (equal? #(1 (2)) (vector 1 (list 2))) (equal? #(1) #(2)) (eqv? (vector 1) (vector 1))) "(#t #f #f)"))
(define-test "AC-6 construct and inspect"
  (check-written (list (make-vector 2 0) (vector 1 2) (vector-length #(1 2 3)) (vector-ref #(a b) 1) (vector? #(1)) (vector? (list 1))) "(#(0 0) #(1 2) 3 b #t #f)"))
(define-test "AC-6 conversions with ranges"
  (check-written (list (vector->list #(1 2 3 4) 1 3) (list->vector (list 1 2)) (vector-copy #(1 2 3) 1) (subvector #(1 2 3 4) 1 3) (vector-append #(1) #() #(2 3))) "((2 3) #(1 2) #(2 3) #(2 3) #(1 2 3))"))
(define-test "AC-6 set!, fill!, map, for-each"
  (check-written (eval-all "(let ((v (make-vector 3 0)) (acc 0)) (vector-set! v 0 5) (vector-for-each (lambda (x) (set! acc (+ acc x))) v) (list v (vector-map (lambda (x) (* 2 x)) v) acc (begin (vector-fill! v 1) v)))") "(#(1 1 1) #(10 0 0) 5 #(1 1 1))"))
(define-test "AC-6 vector-set! on a literal is an error"
  (check-error (eval-all "(vector-set! #(1 2) 0 9)") "vector-set!: vector is immutable (a literal); copy it first"))
(define-test "AC-6 list->array is still there and makes a vector"
  (check-written (vector? (list->array (list 1 2))) "#t"))
(define-test "AC-7 unquote and splicing"
  (check-written (let ((x 1) (ys (list 2 3))) `#(0 ,x ,@ys 4)) "#(0 1 2 3 4)"))
(define-test "AC-7 a constant vector template"
  (check-written (eval-all "`#(a b)") "#(a b)"))
(define-test "AC-7 nested in a list"
  (check-written (let ((x 5)) `(v #(,x))) "(v #(5))"))
(define-test "AC-8 equal? keys"
  (check-written (let ((t (make-hash-table))) (hash-table-set! t "k" 1) (hash-table-set! t (list 1 2) 2) (hash-table-set! t 3 3) (hash-table-set! t #(1) 4) (list (hash-table-ref t (string-copy "k")) (hash-table-ref t (list 1 2)) (hash-table-ref t 3) (hash-table-ref t (vector 1)))) "(1 2 3 4)"))
(define-test "AC-8 eq? table: distinct strings are different keys"
  (check-written (let ((t (make-hash-table eq?))) (hash-table-set! t (string-copy "k") 1) (hash-table-contains? t (string-copy "k"))) "#f"))
(define-test "AC-8 eqv? table: numbers by value, 1 and 1.0 differ"
  (check-written (let ((t (make-hash-table eqv?))) (hash-table-set! t 1 (quote int)) (list (hash-table-ref/default t 1 #f) (hash-table-ref/default t 1.0 #f))) "(int #f)"))
(define-test "AC-8 ref with a thunk, and missing"
  (check-written (let ((t (make-hash-table))) (list (hash-table-ref t 1 (lambda () (quote dflt))) (hash-table-ref/default t 1 0))) "(dflt 0)"))
(define-test "AC-8 missing without a default is an error"
  (check-error (eval-all "(hash-table-ref (make-hash-table) (quote k))") "hash-table-ref: no key: k"))
(define-test "AC-8 insertion order of keys, values, alist"
  (check-written (let ((t (make-hash-table))) (for-each (lambda (k) (hash-table-set! t k (* k 10))) (list 5 1 9 3)) (list (hash-table-keys t) (hash-table-values t) (hash-table->alist t))) "((5 1 9 3) (50 10 90 30) ((5 . 50) (1 . 10) (9 . 90) (3 . 30)))"))
(define-test "AC-8 update!, update!/default, delete!, count, clear!"
  (check-written (let ((t (make-hash-table))) (hash-table-set! t (quote a) 1) (hash-table-update! t (quote a) (lambda (v) (+ v 1))) (hash-table-update!/default t (quote b) (lambda (v) (+ v 1)) 10) (hash-table-delete! t (quote zz)) (let ((before (list (hash-table-ref t (quote a)) (hash-table-ref t (quote b)) (hash-table-count t)))) (hash-table-clear! t) (list before (hash-table-count t)))) "((2 11 2) 0)"))
(define-test "AC-8 walk, copy, alist->hash-table, printing"
  (check-written (eval-all "(let* ((t (alist->hash-table (quote ((a . 1) (b . 2) (a . 9))) eq?)) (c (hash-table-copy t)) (sum 0)) (hash-table-set! c (quote z) 26) (hash-table-walk t (lambda (k v) (set! sum (+ sum v)))) (list t (hash-table-count c) sum (hash-table-ref t (quote a)) (hash-table? t)))") "(#<hash-table 2> 3 3 1 #t)"))
(define-test "AC-8 an unsupported equality"
  (check-error (eval-all "(make-hash-table string=?)") "make-hash-table: the equality must be eq?, eqv? or equal?: #<procedure string=?>"))
(define-test "AC-9 read-char, peek-char, read-line, eof"
  (check-written (let ((p (open-input-string "ab\ncd"))) (list (peek-char p) (read-char p) (read-line p) (read-line p) (eof-object? (read-line p)) (eof-object? (read-char p)))) "(#\\a #\\a \"b\" \"cd\" #t #t)"))
(define-test "AC-9 read-string"
  (check-written (let ((p (open-input-string "abcdef"))) (list (read-string 4 p) (read-string 9 p) (eof-object? (read-string 1 p)))) "(\"abcd\" \"ef\" #t)"))
(define-test "AC-9 read several datums, then eof"
  (check-written (let ((p (open-input-string "(1 2) foo \"s\" #(v)"))) (list (read p) (read p) (read p) (read p) (eof-object? (read p)))) "((1 2) foo \"s\" #(v) #t)"))
(define-test "AC-9 output port: display, write, write-char, newline"
  (check-written (let ((o (open-output-string))) (display "x" o) (write "y" o) (write-char #\z o) (newline o) (write-string "w" o) (get-output-string o)) "\"x\\\"y\\\"z\\nw\""))
(define-test "AC-9 with-output-to-string"
  (check-written (with-output-to-string (lambda () (display 1) (display "a"))) "\"1a\""))
(define-test "AC-9 the eof object prints"
  (check-written (eof-object) "#<eof>"))
(define-test "AC-9 read without a port reads the current input (none here: eof; Phase 7.9)"
  (check-written (eof-object? (read)) "#t"))
(define-test "AC-10 guard catches them"
  (check-written (guard (e ((error-object? e) (quote caught))) (vector-ref #() 0)) "caught"))
(define-test "AC-11 a LISP vector is a Smalltalk Array"
  (check-written (list [#(3 1 2) class] (vector? [(smalltalk Array) with: 1 with: 2]) [#(3 1 2) asSortedCollection]) "(#<Array> #t #<a SortedCollection(1 2 3)>)"))
(define-test "AC-11 strings unchanged"
  (check-written (eval-all "[(string-append \"ab\" \"c\") reversed]") "\"cba\""))

(run-tests)
