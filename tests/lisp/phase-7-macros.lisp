;;; phase-7-macros.lisp -- the language-behavior checks of tests/phase-7-macros.st,
;;; moved to cog-lisp (Phase 8 step 8.1; generated by tests/lisp/convert-suites.py).
;;; Test names keep their spec references (AC-n, review ids).
(load "../../lib/test.lisp")

(define-test "AC-2 unquote and splice"
  (check (eval-all "`(1 ,(+ 1 1) ,@(list 3 4) 5)") '(1 2 3 4 5)))
(define-test "AC-2 dotted tail"
  (check (eval-all "`(1 . ,(+ 1 1))") '(1 . 2)))
(define-test "AC-2 splice at the end"
  (check (eval-all "`(1 ,@(list 2 3))") '(1 2 3)))
(define-test "AC-2 splice of the empty list"
  (check (eval-all "`(1 ,@(list) 2)") '(1 2)))
(define-test "AC-2 constant template"
  (check (eval-all "`(a (b c))") '(a (b c))))
(define-test "AC-2 unquote of a local"
  (check (let ((x 5)) `(x is ,x)) '(x is 5)))
(define-test "AC-2 splice of a non-list is an error"
  (check-error (eval-all "`(1 ,@5)") "not a list"))
(define-test "AC-2 splice outside a list is an error"
  (check-error-class (eval-all "`,@(list 1)") LispCompileError))
(define-test "AC-3 only level-0 unquotes run"
  (check (eval-all "`(a `(b ,(c ,(+ 1 2))))") '(a (quasiquote (b (unquote (c 3)))))))
(define-test "AC-4 cons and append redefined"
  (check (eval-all "(define saved-cons cons) (define saved-append append)
		(define (cons a b) (quote broken)) (define (append . xs) (quote broken))
		(define r `(1 ,(+ 1 1) ,@(list 3 4) 5))
		(set! cons saved-cons) (set! append saved-append)
		r") '(1 2 3 4 5)))
(define-test "setup"
  (eval-all "(define-macro (swap! a b) (let ((tmp (gensym))) `(let ((,tmp ,a)) (set! ,a ,b) (set! ,b ,tmp))))"))
(define-test "AC-5 swap! on globals"
  (check (eval-all "(define p 1) (define q 2) (swap! p q) (list p q)") '(2 1)))
(define-test "AC-5 swap! on locals"
  (check (let ((x (quote a)) (y (quote b))) (swap! x y) (list x y)) '(b a)))
(define-test "setup"
  (eval-all "(define-macro (m2 x) `(+ ,x 1)) (define-macro (m1 x) `(m2 (m2 ,x)))"))
(define-test "AC-6 a macro expanding into macro calls"
  (check (m1 5) 7))
(define-test "setup"
  (eval-all "(define-macro (my-unless test . body) `(when (not ,test) ,@body))"))
(define-test "AC-6 a user macro over a core macro"
  (check (my-unless #f 1 42) 42))
(define-test "AC-6 a macro used inside a lambda"
  (check ((lambda (n) (m1 n)) 10) 12))
(define-test "AC-7 self loop through cond"
  (check (eval-all "(define (lp n) (cond ((= n 0) (quote done)) (else (lp (- n 1))))) (lp 1000000)") 'done))
(define-test "AC-7 mutual recursion through cond, constant stack"
  (check (eval-all "(define (pe2 n) (cond ((= n 0) (stack-depth)) (else (po2 (- n 1)))))
		(define (po2 n) (cond ((= n 0) (stack-depth)) (else (pe2 (- n 1)))))
		(= (pe2 10) (pe2 10000))") #t))
(define-test "AC-7 mutual recursion through and / or"
  (check (eval-all "(define (ev3 n) (or (= n 0) (od3 (- n 1)))) (define (od3 n) (and (not (= n 0)) (ev3 (- n 1)))) (list (ev3 100000) (ev3 100001))") '(#t #f)))
(define-test "AC-8 macroexpand-1 of when"
  (check (macroexpand-1 (quote (when x 1 2))) '(if x (begin 1 2))))
(define-test "AC-8 macroexpand-1 expands once"
  (check (macroexpand-1 (quote (m1 5))) '(m2 (m2 5))))
(define-test "AC-8 macroexpand expands the top repeatedly"
  (check (macroexpand (quote (m1 5))) '(+ (m2 5) 1)))
(define-test "AC-8 a non-macro form is unchanged"
  (check (macroexpand-1 (quote (foo 1))) '(foo 1)))
(define-test "AC-8 an atom is unchanged"
  (check (macroexpand (quote x)) 'x))
(define-test "AC-9 two gensyms differ"
  (check (eq? (gensym) (gensym)) #f))
(define-test "AC-9 a gensym macro does not capture a user variable"
  (check (eval-all "(define-macro (my-or a b) (let ((t (gensym))) `(let ((,t ,a)) (if ,t ,t ,b)))) (let ((t 5)) (my-or #f t))") 5))
(define-test "AC-9 core or does not capture either"
  (check (let ((t 6)) (or #f t)) 6))
(define-test "AC-10 let-bound when is a variable"
  (check (let ((when 5)) when) 5))
(define-test "AC-10 let-bound when is called"
  (check (let ((when (lambda (x) (* x 2)))) (when 4)) 8))
(define-test "AC-10 a lambda parameter shadows"
  (check ((lambda (and) (and 1 2)) +) 3))
(define-test "AC-11 a macro used as a value"
  (check-error (eval-all "(map and (list 1))") "macro used as a value"))
(define-test "AC-11 define-macro inside a body"
  (check-error-class (eval-all "(define (f) (define-macro (mm) 1) 1)") LispCompileError))
(define-test "AC-11 define-macro inside an expression"
  (check-error-class (eval-all "(list (define-macro (mm) 1))") LispCompileError))
(define-test "setup"
  (eval-all "(define-macro (bad-macro x) (car x))"))
(define-test "AC-11 an expander error names the macro"
  (check-error (eval-all "(bad-macro 5)") "bad-macro"))
(define-test "AC-12 eval of a built list"
  (check (eval (list (quote +) 1 2)) 3))
(define-test "AC-12 eval of a quasiquoted form"
  (check (eval `(* ,(+ 1 1) 5)) 10))
(define-test "AC-12 eval of a define"
  (check (eval-all "(eval (quote (define ev-made 9))) ev-made") 9))
(define-test "AC-13 internal defines in a lambda body"
  (check (eval-all "(define (f1 x) (define y (* x 2)) (define z (+ y 1)) (list y z)) (f1 5)") '(10 11)))
(define-test "AC-13 mutually recursive local procedures"
  (check (eval-all "(define (f2 n) (define (e? k) (if (= k 0) #t (o? (- k 1)))) (define (o? k) (if (= k 0) #f (e? (- k 1)))) (list (e? n) (o? n))) (f2 7)") '(#f #t)))
(define-test "AC-13 internal defines do not leak"
  (check (eval-all "(define (f3) (define hidden-x 1) hidden-x) (f3)") 1))
(define-test "AC-13 ... and are not global"
  (check-error-class (eval-all "hidden-x") LispUnboundError))
(define-test "AC-13 internal defines in a let body"
  (check (eval-all "(let ((a 1)) (define b (+ a 1)) (* a b 10))") 20))
(define-test "AC-13 internal define with set!"
  (check (eval-all "(define (f4) (define c 0) (set! c (+ c 5)) c) (f4)") 5))
(define-test "AC-13 local procedure as a closure"
  (check (eval-all "(define (adder n) (define (add k) (+ n k)) add) ((adder 3) 4)") 7))
(define-test "AC-13 a define after an expression is an error"
  (check-error-class (eval-all "(define (f5) 1 (define x 2) x)") LispCompileError))
(define-test "setup"
  (eval-all "(define-macro (defn2 name params . body) `(define (,name ,@params) ,@body))"))
(define-test "AC-13 a macro expanding to define makes a local"
  (check (eval-all "(define (f6) (defn2 helper6 (x) (* x 3)) (helper6 4)) (f6)") 12))
(define-test "AC-13 ... not a global"
  (check-error-class (eval-all "helper6") LispUnboundError))
(define-test "AC-13 ... and keeps the macro call text"
  (check (eval-all "(define (f7) (defn2 sq7 (x) (* x x)) sq7) (procedure-source (f7))") "(defn2 sq7 (x) (* x x))"))
(define-test "AC-13 a macro expanding to several defines (begin is spliced)"
  (check (eval-all "(define-macro (two-defs a b) `(begin (define ,a 1) (define ,b 2))) (define (f8) (two-defs p8 q8) (+ p8 q8)) (f8)") 3))
(define-test "AC-13 ... not globals"
  (check-error-class (eval-all "p8") LispUnboundError))
(define-test "AC-13 a begin of defines at the start of a body"
  (check (eval-all "(define (f9) (begin (define a 1) (define b 2)) (+ a b)) (f9)") 3))
(define-test "AC-13 a local define shadows a macro in later forms"
  (check (eval-all "(define (f10) (define (when x) (* x 10)) (when 4)) (f10)") 40))
(define-test "AC-13 a define inside an expression is an error"
  (check-error-class (eval-all "(define (f11) (if #t (define zz 1)) 2)") LispCompileError))
(define-test "AC-13 a macro define after an expression is an error"
  (check-error-class (eval-all "(define (f12) 1 (defn2 late (x) x) 2)") LispCompileError))
(define-test "AC-13 top level: a begin of defines is still global"
  (check (eval-all "(begin (define tb1 1) (define tb2 2)) (+ tb1 tb2)") 3))
(define-test "AC-14 cond"
  (check (cond ((= 1 2) 1) ((= 1 1) 2) (else 3)) 2))
(define-test "AC-14 cond else"
  (check (cond (#f 1) (else 3)) 3))
(define-test "AC-14 cond test only"
  (check (cond (#f) (7)) 7))
(define-test "AC-14 cond =>"
  (check (cond ((assv 2 (quote ((1 . a) (2 . b)))) => cdr) (else 0)) 'b))
(define-test "AC-14 case"
  (check (case 3 ((1 2) (quote low)) ((3 4) (quote mid)) (else (quote high))) 'mid))
(define-test "AC-14 case else"
  (check (case 9 ((1 2) (quote low)) (else (quote high))) 'high))
(define-test "AC-14 case on symbols"
  (check (case (quote b) ((a) 1) ((b c) 2)) 2))
(define-test "AC-14 and"
  (check (list (and 1 2 3) (and 1 #f 3)) '(3 #f)))
(define-test "AC-14 or"
  (check (list (or #f #f 7) (or #f #f)) '(7 #f)))
(define-test "AC-14 (and) and (or)"
  (check (list (and) (or)) '(#t #f)))
(define-test "AC-14 when"
  (check (when (= 1 1) 1 2) 2))
(define-test "AC-14 unless"
  (check (unless (= 1 2) 3) 3))
(define-test "AC-14 let*"
  (check (let* ((x 1) (y (+ x 1)) (z (* y 10))) (list x y z)) '(1 2 20)))
(define-test "AC-14 let* with no bindings"
  (check (let* () 5) 5))
(define-test "AC-14 letrec"
  (check (letrec ((e? (lambda (n) (if (= n 0) #t (o? (- n 1))))) (o? (lambda (n) (if (= n 0) #f (e? (- n 1)))))) (e? 10)) #t))
(define-test "AC-14 letrec*"
  (check (letrec* ((a 1) (b (+ a 1))) (list a b)) '(1 2)))
(define-test "AC-14 named let"
  (check (let loop ((i 0) (acc (list))) (if (= i 3) acc (loop (+ i 1) (cons i acc)))) '(2 1 0)))
(define-test "AC-14 do"
  (check (do ((i 0 (+ i 1)) (s 0 (+ s i))) ((= i 5) s)) 10))
(define-test "AC-14 do with a body and a stepless variable"
  (check (eval-all "(do ((v (list)) (i 0 (+ i 1))) ((= i 3) v) (set! v (cons i v)))") '(2 1 0)))
(define-test "setup"
  (eval-all "(define trail (list)) (define (note x) (set! trail (cons x trail)) x)"))
(define-test "AC-15 and stops at the first false"
  (check (eval-all "(set! trail (list)) (and (note 1) (note #f) (note 3)) trail") '(#f 1)))
(define-test "AC-15 or stops at the first true"
  (check (eval-all "(set! trail (list)) (or (note #f) (note 2) (note 3)) trail") '(2 #f)))
(define-test "AC-15 or evaluates its operand once"
  (check (eval-all "(set! trail (list)) (or (note 5)) trail") '(5)))
(define-test "AC-16 named let 100,000"
  (check (let loop ((i 0) (d 0)) (if (= i 100000) (= d (stack-depth)) (loop (+ i 1) (if (= i 1) (stack-depth) d)))) #t))
(define-test "AC-16 do 100,000"
  (check (do ((i 0 (+ i 1)) (d 0 (if (= i 1) (stack-depth) d))) ((= i 100000) (= d (stack-depth)))) #t))
(define-test "AC-16 named let sum"
  (check (let loop ((i 0) (acc 0)) (if (= i 100000) acc (loop (+ i 1) (+ acc i)))) 4999950000))
(define-test "setup"
  (eval-all "(define-macro (defn name params . body) `(define (,name ,@params) ,@body))"))
(define-test "setup"
  (eval-all "(defn sq (x) (* x x))"))
(define-test "AC-17 a procedure defined by a user macro keeps the call text"
  (check (eval-all "(procedure-source sq)") "(defn sq (x) (* x x))"))
(define-test "AC-17 ... and still works"
  (check (sq 9) 81))
(define-test "AC-17 an internal define keeps its text"
  (check (eval-all "(define (outer) (define (inner y) (+ y 1)) inner) (procedure-source (outer))") "(define (inner y) (+ y 1))"))
(define-test "setup (from a check that stays in the suite)"
  (guard (e (#t #f)) (eval-all "(load \"../../lib/cl.lisp\")")))
(define-test "AC-18 defun"
  (check (eval-all "(defun sq2 (x) (* x x)) (sq2 5)") 25))
(define-test "AC-18 defun keeps its text"
  (check (eval-all "(procedure-source sq2)") "(defun sq2 (x) (* x x))"))
(define-test "AC-18 defun with &rest"
  (check (eval-all "(defun collect (a &rest xs) (cons a xs)) (collect 1 2 3)") '(1 2 3)))
(define-test "AC-18 defmacro and defvar"
  (check (eval-all "(defmacro my-inc (place &rest amt) `(setq ,place (+ ,place ,(if (null amt) 1 (car amt))))) (defvar cnt 0) (my-inc cnt) (my-inc cnt 5) cnt") 6))
(define-test "AC-18 defparameter"
  (check (eval-all "(defparameter *limit* 10) *limit*") 10))
(define-test "AC-18 setq with pairs"
  (check (eval-all "(defvar a1 0) (defvar b1 0) (list (setq a1 1 b1 2) a1 b1)") '(2 1 2)))
(define-test "AC-18 progn and prog1"
  (check (list (progn 1 2 3) (prog1 1 2 3)) '(3 1)))
(define-test "AC-18 dolist"
  (check (let ((s 0)) (dolist (x (list 1 2 3) s) (setq s (+ s x)))) 6))
(define-test "AC-18 dotimes"
  (check (let ((s 0)) (dotimes (i 5 s) (setq s (+ s i)))) 10))
(define-test "AC-18 labels"
  (check (labels ((f (n) (if (= n 0) 0 (+ 1 (g (- n 1))))) (g (n) (if (= n 0) 0 (+ 1 (f (- n 1)))))) (f 6)) 6))
(define-test "AC-18 flet"
  (check (flet ((dbl (x) (* 2 x))) (dbl 21)) 42))
(define-test "AC-18 push and pop"
  (check (let ((stk nil)) (push 1 stk) (push 2 stk) (list (pop stk) stk)) '(2 (1))))
(define-test "AC-18 mapcar"
  (check (mapcar (lambda (x) (* x x)) (list 1 2 3)) '(1 4 9)))
(define-test "AC-18 funcall"
  (check (funcall + 1 2 3) 6))
(define-test "AC-18 nth and nthcdr"
  (check (list (nth 2 (quote (a b c))) (nthcdr 1 (quote (a b c)))) '(c (b c))))
(define-test "AC-18 first second third rest last"
  (check (let ((l (quote (1 2 3)))) (list (first l) (second l) (third l) (rest l) (last l))) '(1 2 3 (2 3) (3))))
(define-test "AC-18 predicates"
  (check (list (consp (list 1)) (listp nil) (atom 3) (null nil) (eql 2 2)) '(#t #t #t #t #t)))
(define-test "AC-18 cond with null and t"
  (check (eval-all "(defun len (x) (cond ((null x) 0) (t (+ 1 (len (cdr x)))))) (len (list 1 2 3))") 3))
(define-test "regression: closures in a self-loop capture each iteration"
  (check (eval-all "(define (mk n acc) (if (= n 0) acc (mk (- n 1) (cons (lambda () n) acc)))) (map (lambda (g) (g)) (mk 3 (list)))") '(1 2 3)))
(define-test "regression: ... with a set! inside the loop"
  (check (eval-all "(define (mk2 n acc) (if (= n 0) acc (begin (set! n n) (mk2 (- n 1) (cons (lambda () n) acc))))) (map (lambda (g) (g)) (mk2 3 (list)))") '(1 2 3)))

(run-tests)
