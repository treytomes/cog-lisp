;;; phase-7.5-review.lisp -- the language-behavior checks of tests/phase-7.5-review.st,
;;; moved to cog-lisp (Phase 8 step 8.1; generated by tests/lisp/convert-suites.py).
;;; Test names keep their spec references (AC-n, review ids).
(load "../../lib/test.lisp")

(define-test "R-2 car of a number"
  (check-error (eval-all "(car 5)") "car: not a pair: 5"))
(define-test "R-2 car of the empty list"
  (check-error (eval-all "(car (quote ()))") "car: not a pair: ()"))
(define-test "R-2 set-car! of a number"
  (check-error (eval-all "(set-car! 5 1)") "set-car!: not a pair: 5"))
(define-test "R-2 length of a number"
  (check-error (eval-all "(length 5)") "length: not a proper list: 5"))
(define-test "R-2 map over a non-list"
  (check-error (eval-all "(map car 5)") "map: not a proper list: 5"))
(define-test "R-2 assq over a non-list"
  (check-error (eval-all "(assq 1 5)") "assq: not a proper list: 5"))
(define-test "R-2 arithmetic on a string"
  (check-error (eval-all "(+ 1 \"a\")") "+: not a number"))
(define-test "R-2 division by zero"
  (check-error (eval-all "(/ 1 0)") "division by zero"))
(define-test "R-9 length of a dotted list is an error"
  (check-error (eval-all "(length (quote (1 . 2)))") "length: not a proper list: (1 . 2)"))
(define-test "R-9 apply of a dotted list is an error"
  (check-error (eval-all "(apply + (quote (1 . 2)))") "apply: not a proper list: (1 . 2)"))
(define-test "R-9 append keeps an improper last argument"
  (check (append (quote (1)) (quote (2 . 3))) '(1 2 . 3)))
(define-test "R-9 append of () and an atom is the atom"
  (check (append (quote ()) 5) 5))
(define-test "R-9 append shares its last argument"
  (check (eval-all "(define tl (list 3)) (eq? tl (cdr (cdr (append (list 1 2) tl))))") #t))
(define-test "R-9 append with no arguments"
  (check (append) '()))
(define-test "R-4 length of a circular list is an error, not a hang"
  (check-error (eval-all "(define cy (list 1 2)) (set-cdr! (cdr cy) cy) (length cy)") "length: circular list"))
(define-test "setup (from a check that stays in the suite)"
  (guard (e (#t #f)) (eval-all "(define cy2 (list 1 2)) (set-cdr! (cdr cy2) cy2) (car (cons 5 cy2)) (map car (cons 1 cy2))")))
(define-test "setup (from a check that stays in the suite)"
  (guard (e (#t #f)) (eval-all "(define (sq x) (* x x)) sq")))
(define-test "setup (from a check that stays in the suite)"
  (guard (e (#t #f)) (eval-all "(define sq-alias sq) sq-alias")))
(define-test "setup (from a check that stays in the suite)"
  (guard (e (#t #f)) (eval-all "(define (outer) (define (inner y) y) inner) (outer)")))
(define-test "setup (from a check that stays in the suite)"
  (guard (e (#t #f)) (eval-all "(define lam (lambda (x) x)) lam")))
(define-test "R-7 arity message names the procedure"
  (check-error (eval-all "(sq)") "sq: expected 1 argument, got 0"))
(define-test "R-7 arity message for a primitive"
  (check-error (eval-all "(car 1 2)") "car: expected 1 argument, got 2"))
(define-test "R-7 arity message for a variadic procedure"
  (check-error (eval-all "(define (va a . r) a) (va)") "va: expected at least 1 argument, got 0"))
(define-test "setup (from a check that stays in the suite)"
  (guard (e (#t #f)) (eval-all "(define (lp n) (if (= n 0) 0 (lp (- n 1)))) lp")))
(define-test "C-6 well-formed forms still compile"
  (check (let ((a 1)) ((lambda (x . r) (list x r)) a 2 3)) '(1 (2 3))))
(define-test "setup (from a check that stays in the suite)"
  (guard (e (#t #f)) (eval-all "(define-macro (forever) (quote (forever))) (forever)")))
(define-test "setup (from a check that stays in the suite)"
  (guard (e (#t #f)) (eval-all "(define (fv) (forever) 1)")))
(define-test "C-7 deep but finite expansion still works"
  (check (eval-all "(define-macro (count-down n) (if (= n 0) (quote (quote done)) `(count-down ,(- n 1)))) (count-down 2000)") 'done))
(define-test "setup (from a check that stays in the suite)"
  (guard (e (#t #f)) (eval-all "(define (rr) (+ 1 (rr))) (rr)")))
(define-test "setup (from a check that stays in the suite)"
  (guard (e (#t #f)) (eval-all "(define (cnt n) (if (= n 0) 0 (+ 1 (cnt (- n 1))))) (cnt 10000)")))
(define-test "C-1 arguments are all evaluated before any is assigned"
  (check (eval-all "(define (sw n a b) (if (= n 0) (list a b) (sw (- n 1) b a))) (sw 3 1 2)") '(2 1)))
(define-test "C-1 a non-tail self call inside an argument"
  (check (eval-all "(define (nt n acc) (if (= n 0) acc (nt (- n 1) (+ acc (if (= n 1) (nt 0 100) 1))))) (nt 5 0)") 104))
(define-test "C-12 a macro in a self-tail-call argument expands once"
  (check (eval-all "(define expansions 0) (define-macro (counted x) (set! expansions (+ expansions 1)) x) (define (ce n) (if (= n 0) 0 (ce (counted (- n 1))))) (ce 3) expansions") 1))
(define-test "C-8 redefining a local procedure with set! mid-loop is followed"
  (check (eval-all "(define (rl) (define (f n) (if (= n 0) (quote old) (begin (if (= n 2) (set! f (lambda (k) (quote new)))) (f (- n 1))))) (f 5)) (rl)") 'new))
(define-test "C-8 a name rebound in the body is not a self call"
  (check (eval-all "(define (sh) (define (f n) (if (= n 0) 0 (let ((f (lambda (k) 42))) (f (- n 1))))) (f 3)) (sh)") 42))
(define-test "C-8 closures made in a named let keep each iteration"
  (check (map (lambda (g) (g)) (let lp ((i 3) (acc (list))) (if (= i 0) acc (lp (- i 1) (cons (lambda () i) acc))))) '(1 2 3)))
(define-test "setup"
  (eval-all "(define (gl n acc) (if (= n 0) acc (gl (- n 1) (+ acc 1)))) (define (nl n) (let lp ((i n) (acc 0)) (if (= i 0) acc (lp (- i 1) (+ acc 1)))))"))
(define-test "setup"
  (eval-all "(gl 100000 0) (nl 100000)"))
(define-test "C-9 set! of a parameter"
  (check (eval-all "(define (f9 x) (set! x (+ x 1)) x) (f9 1)") 2))
(define-test "C-9 a closure over a set! variable still sees updates"
  (check (eval-all "(define (mkc) (let ((c 0)) (lambda () (set! c (+ c 1)) c))) (define c9 (mkc)) (c9) (c9)") 2))
(define-test "C-10 named let source"
  (check (eval-all "(procedure-source (let lp ((i 0)) lp))") "(let lp ((i 0)) lp)"))
(define-test "C-11 define-macro in a top-level begin, used later in it"
  (check (eval-all "(begin (define-macro (m11) 11) (m11))") 11))
(define-test "C-11 a macro that defines two macros"
  (check (eval-all "(define-macro (two-macros) (quote (begin (define-macro (ma) 1) (define-macro (mb) 2)))) (two-macros) (+ (ma) (mb))") 3))
(define-test "C-11 an empty top-level begin"
  (check (begin) (if #f #f)))
(define-test "setup (from a check that stays in the suite)"
  (guard (e (#t #f)) (eval-all "(define-macro (qg) (let ((g (gensym))) `(eq? (quote ,g) (quote ,g)))) (qg)")))
(define-test "C-3 splices between runs"
  (check (let ((x 1) (ys (list 2 3))) `(0 ,x ,@ys 4 ,x ,@ys . 5)) '(0 1 2 3 4 1 2 3 . 5)))
(define-test "C-3 a dotted unquote tail"
  (check (let ((x 2)) `(1 . ,x)) '(1 . 2)))
(define-test "C-3 nested levels still right"
  (check (eval-all "`(a `(b ,(c ,(+ 1 2))))") '(a (quasiquote (b (unquote (c 3)))))))
(define-test "O-1 four-argument arithmetic"
  (check (list (+ 1 2 3 4) (* 1 2 3 4) (- 10 1 2 3) (+) (*)) '(10 24 4 0 1)))
(define-test "O-1 chained comparisons"
  (check (list (< 1 2 3) (< 1 3 2) (<= 1 1 2 2) (= 2 2 2 2) (> 3 2 1) (>= 3 3 4)) '(#t #f #t #t #t #f)))
(define-test "R-4 list? of a circular list is #f"
  (check (eval-all "(define cy3 (list 1 2)) (set-cdr! (cdr cy3) cy3) (list? cy3)") #f))
(define-test "R-4 list? still right on proper and dotted lists"
  (check (list (list? (quote (1 2 3))) (list? (quote (1 . 2))) (list? (quote ()))) '(#t #f #t)))
(define-test "R-12 eqv? tells 0.0 from -0.0"
  (check (list (eqv? 0.0 -0.0) (eqv? -0.0 -0.0) (= 0.0 -0.0)) '(#f #t #t)))

(run-tests)
