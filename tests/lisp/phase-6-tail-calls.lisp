;;; phase-6-tail-calls.lisp -- the language-behavior checks of tests/phase-6-tail-calls.st,
;;; moved to cog-lisp (Phase 8 step 8.1; generated by tests/lisp/convert-suites.py).
;;; Test names keep their spec references (AC-n, review ids).
(load "../../lib/test.lisp")

(define-test "AC-1 loop of 1,000,000"
  (check (eval-all "(define (loop n acc) (if (= n 0) acc (loop (- n 1) (+ acc 1)))) (loop 1000000 0)") 1000000))
(define-test "setup (from a check that stays in the suite)"
  (guard (e (#t #f)) (eval-all "(define (d n first) (if (= n 0) (list first (stack-depth)) (d (- n 1) (if (= n 1000) (stack-depth) first)))) (d 1000 0)")))
(define-test "AC-2 even?/odd? of 100,000"
  (check (eval-all "(define (ev? n) (if (= n 0) #t (od? (- n 1)))) (define (od? n) (if (= n 0) #f (ev? (- n 1)))) (ev? 100000)") #t))
(define-test "AC-2 stack depth constant"
  (check (eval-all "(define (pe n) (if (= n 0) (stack-depth) (po (- n 1)))) (define (po n) (if (= n 0) (stack-depth) (pe (- n 1)))) (= (pe 10) (pe 10000))") #t))
(define-test "setup (from a check that stays in the suite)"
  (guard (e (#t #f)) (eval-all "(define (b n samples) (begin 1 (let ((m (- n 1))) (if (= n 0) samples (b m (if (= n 500) (cons (stack-depth) samples) (if (= n 2) (cons (stack-depth) samples) samples))))))) (b 500 (list))")))
(define-test "AC-3 tail call from the else branch of a nested if"
  (check (eval-all "(define (z n) (if (> n 0) (if (= n 1) (z 0) (z (- n 1))) (quote done))) (z 100000)") 'done))
(define-test "AC-4 fact 20"
  (check (eval-all "(define (fact n) (if (= n 0) 1 (* n (fact (- n 1))))) (fact 20)") 2432902008176640000))
(define-test "AC-4 non-tail recursion grows the stack"
  (check (eval-all "(define (nt n) (if (= n 0) (stack-depth) (+ 0 (nt (- n 1))))) (< (nt 10) (nt 100))") #t))
(define-test "AC-5 redefinition followed"
  (check (eval-all "(define (rf n) (if (= n 0) (quote old) (rf (- n 1)))) (define saved rf) (define (rf n) (quote new)) (saved 3)") 'new))
(define-test "AC-5 unredefined still loops"
  (check (eval-all "(define (rg n) (if (= n 0) (quote ok) (rg (- n 1)))) (rg 100000)") 'ok))
(define-test "setup"
  (eval-all "(define (inc x) (+ x 1))"))
(define-test "AC-6 map"
  (check (map (lambda (x) (inc x)) '(1 2 3)) '(2 3 4)))
(define-test "AC-6 apply"
  (check (apply (lambda (x y) (inc (+ x y))) '(1 2)) 4))
(define-test "AC-6 for-each"
  (check (eval-all "(define acc 0) (for-each (lambda (x) (set! acc (inc (+ acc x)))) '(1 2 3)) acc") 9))
(define-test "AC-6 a procedure value returned from a tail call"
  (check (eval-all "(define (mk) (inc 1)) (mk)") 2))
(define-test "AC-6 a tail call through apply runs in constant stack"
  (check (eval-all "(define (ap n) (if (= n 0) (stack-depth) (apply ap (list (- n 1))))) (= (ap 10) (ap 10000))") #t))
(define-test "AC-6 a tail call to a primitive returns its value"
  (check (eval-all "(define (tp a b) (+ a b)) (tp 2 3)") 5))
(define-test "AC-7 arity error, fast path"
  (check-error-class (eval-all "((lambda (x) x) 1 2)") LispArityError))
(define-test "AC-7 arity error, tail call"
  (check-error-class (eval-all "(define (t1) ((lambda (x) x))) (t1)") LispArityError))
(define-test "AC-7 not applicable, tail call"
  (check-error (eval-all "(define (t2) (5 6)) (t2)")))
(define-test "AC-7 not applicable, fast path"
  (check-error (eval-all "(5 6)")))
(define-test "AC-8 zero arguments"
  (check ((lambda () 7)) 7))
(define-test "AC-8 four arguments"
  (check ((lambda (a b c d) (list a b c d)) 1 2 3 4) '(1 2 3 4)))
(define-test "AC-8 six arguments"
  (check ((lambda (a b c d e f) (+ a b c d e f)) 1 2 3 4 5 6) 21))
(define-test "AC-8 variadic primitive"
  (check (list 1 2 3 4 5 6) '(1 2 3 4 5 6)))
(define-test "AC-8 direct entries of variadic primitives agree with the general path"
  (check (list (+ 7) (+ 1 2) (+ 1 2 3) (+ 1 2 3 4) (- 5) (- 10 3) (- 10 3 2) (* 3 4) (/ 8 2) (< 1 2) (< 1 3 2) (= 2 2) (> 1 2) (<= 2 2) (>= 1 2) (min 3 1) (max 3 1)) '(7 3 6 10 -5 7 5 12 4 #t #f #t #f #t #f 1 3)))
(define-test "AC-8 an entry still type-checks its arguments"
  (check-error (eval-all "(+ 1 (quote a))")))
(define-test "AC-9 forward reference"
  (check (eval-all "(define (fwa) (fwb 4)) (define (fwb x) (* x 10)) (fwa)") 40))
(define-test "AC-9 redefinition visible to compiled code"
  (check (eval-all "(define v 1) (define (get-v) v) (define v 2) (get-v)") 2))
(define-test "AC-9 unbound reference raises"
  (check-error-class (eval-all "(define (bad) not-yet-defined-anywhere) (bad)") LispUnboundError))
(define-test "AC-9 set-bang of unbound raises"
  (check-error-class (eval-all "(set! also-not-defined 1)") LispUnboundError))
(define-test "AC-10 same object each evaluation"
  (check (eval-all "(define (k) '(1 2)) (eq? (k) (k))") #t))
(define-test "AC-11 two bindings"
  (check (let ((x 1) (y 2)) (+ x y)) 3))
(define-test "AC-11 bindings see the outer scope"
  (check (let ((x 1)) (let ((x 2) (y x)) y)) 1))
(define-test "AC-11 five bindings"
  (check (let ((a 1) (b 2) (c 3) (d 4) (e 5)) (+ a b c d e)) 15))
(define-test "AC-11 a fresh binding per evaluation"
  (check (eval-all "(define (mk n acc) (if (= n 0) acc (mk (- n 1) (cons (let ((k n)) (lambda () k)) acc)))) (map (lambda (f) (f)) (mk 3 (list)))") '(1 2 3)))
(define-test "AC-19 every inline form gives the call result"
  (check (list (+ 2 3) (- 2 3) (* 2 3) (= 2 2) (< 2 3) (> 2 3) (<= 3 3) (>= 2 3) (eq? (quote a) (quote a)) (car (cons 1 2)) (cdr (cons 1 2)) (not #f) (not 0) (null? (list)) (null? (list 1))) '(5 -1 6 #t #t #f #t #f #t 1 2 #t #f #t #f)))
(define-test "AC-19 inline form in tail position"
  (check (eval-all "(define (in-tail a b) (* a b)) (in-tail 6 7)") 42))
(define-test "AC-19 nested inline forms"
  (check (eval-all "(define (poly x) (+ (* x (+ (* x 2) 3)) 4)) (poly 5)") 69))
(define-test "AC-19 an inlined form still type-checks"
  (check-error (eval-all "(define (bad-car x) (car x)) (bad-car 5)")))
(define-test "AC-20 compiled with the primitive, then + is redefined"
  (check (eval-all "(define (add2 a b) (+ a b)) (define orig-plus +) (define (+ a b) (quote plus)) (add2 1 2)") 'plus))
(define-test "AC-21 compiled while + is redefined"
  (check (eval-all "(define (add3 a b) (+ a b)) (add3 1 2)") 'plus))
(define-test "AC-20 restoring + restores the result"
  (check (eval-all "(define + orig-plus) (list (add2 1 2) (add3 1 2))") '(3 3)))
(define-test "AC-19 a wide expression stays within the frame limit"
  (check (eval-all "(define (wide p) (list (car p) (+ (car p) (cdr p)) (* (car p) (car p)) (- (cdr p) (car p)) (+ (car p) (car p)) (+ (cdr p) (cdr p)) (* (cdr p) (car p)) (+ (car p) (* 2 (cdr p))) (- (car p) (+ 1 (cdr p))) (+ (+ (car p) 1) (+ (cdr p) 1)) (* (+ (car p) 1) (- (cdr p) 1)) (+ (car p) (+ (car p) (+ (car p) (cdr p)))) (- (* (car p) 3) (* (cdr p) 2)) (+ (* (car p) (car p)) (* (cdr p) (cdr p))))) (wide (cons 2 3))") '(2 5 4 1 4 6 6 8 -2 7 6 9 0 13)))
(define-test "AC-22 a local named + is not inlined"
  (check (let ((+ -)) (+ 5 3)) 2))
(define-test "AC-22 a parameter named car is not inlined"
  (check ((lambda (car x) (car x)) (lambda (v) (* v 10)) 4) 40))
(define-test "setup"
  (eval-all "(define (inl a b) (+ a b))"))

(run-tests)
