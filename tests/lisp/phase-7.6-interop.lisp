;;; phase-7.6-interop.lisp -- the language-behavior checks of tests/phase-7.6-interop.st,
;;; moved to cog-lisp (Phase 8 step 8.1; generated by tests/lisp/convert-suites.py).
;;; Test names keep their spec references (AC-n, review ids).
(load "../../lib/test.lisp")

(define-test "AC-1 unary"
  (check (send "abc" size) 3))
(define-test "AC-1 binary"
  (check (send 3 + 4) 7))
(define-test "AC-1 keyword"
  (check (eval-all "(define d (send (smalltalk Dictionary) new)) (send d at:put: 1 2) (send d at: 1)") 2))
(define-test "AC-1 a send in tail position answers its value"
  (check (eval-all "(define (sz s) (send s size)) (sz \"four\")") 4))
(define-test "AC-1 an inlined selector runs the real method"
  (check (send #t ifTrue:ifFalse: (lambda () 1) (lambda () 2)) 1))
(define-test "AC-1 and: with a LISP block"
  (check (send #t and: (lambda () (quote yes))) 'yes))
(define-test "AC-4 receiver then arguments, left to right, once"
  (check (eval-all "(define order (list)) (define (note x) (set! order (cons x order)) x) (send (note 5) between:and: (note 1) (note 9)) (reverse order)") '(5 1 9)))
(define-test "AC-5 brackets evaluate"
  (check (let ((c [OrderedCollection new])) [c add: 1] [c add: 2] [c size]) 2))
(define-test "AC-8 smalltalk-global of an unknown name"
  (check (smalltalk-global "NoSuchThing") #f))
(define-test "AC-9 with a LISP symbol"
  (check (smalltalk-send 12 (quote gcd:) 18) 6))
(define-test "AC-9 with a string"
  (check (smalltalk-send "interop" "copyFrom:to:" 1 5) "inter"))
(define-test "AC-9 with a Smalltalk symbol"
  (check (smalltalk-send "abc" (smalltalk-selector "reversed")) "cba"))
(define-test "AC-10 smalltalk-nil?"
  (check (list (smalltalk-nil? (smalltalk-nil)) (smalltalk-nil? #f) (smalltalk-nil? (quote ()))) '(#t #f #f)))
(define-test "AC-10 nil is true in if"
  (check (if (smalltalk-nil) 1 2) 1))
(define-test "AC-10 a method answering nil"
  (check (smalltalk-nil? [[Dictionary new] at: 1 ifAbsent: smalltalk-nil]) #t))
(define-test "AC-11 round trip"
  (check (eq? (quote foo) (lisp-symbol (smalltalk-symbol (quote foo)))) #t))
(define-test "AC-11 a Smalltalk symbol is neither string? nor symbol?"
  (check (let ((s (smalltalk-symbol (quote foo)))) (list (string? s) (symbol? s))) '(#f #f)))
(define-test "AC-12 array->list"
  (check (array->list (list->array (quote (1 (2) 3)))) '(1 (2) 3)))
(define-test "AC-12 the empty list"
  (check (array->list (list->array (quote ()))) '()))
(define-test "AC-12 array->list of an Interval"
  (check (array->list [1 to: 3]) '(1 2 3)))
(define-test "AC-12 list->array of an improper list is an error"
  (check-error (eval-all "(list->array (quote (1 . 2)))") "list->array: not a proper list: (1 . 2)"))
(define-test "AC-14 collect:"
  (check (array->list [[1 to: 3] collect: (lambda (n) (* n n))]) '(1 4 9)))
(define-test "AC-14 select:"
  (check (array->list [(list->array (quote (1 2 3 4))) select: (lambda (n) (= (modulo n 2) 0))]) '(2 4)))
(define-test "AC-14 inject:into: with a primitive"
  (check (eval-all "[(list->array (quote (1 2 3))) inject: 0 into: +]") 6))
(define-test "AC-14 detect:ifNone:"
  (check (eval-all "[(list->array (quote (1 2))) detect: (lambda (n) (> n 5)) ifNone: (lambda () (quote none))]") 'none))
(define-test "AC-14 sort:"
  (check (array->list [(list->array (quote (3 1 2))) sort: (lambda (a b) (> a b))]) '(3 2 1)))
(define-test "AC-14 at:ifAbsent:"
  (check (eval-all "[[Dictionary new] at: 1 ifAbsent: (lambda () 99)]") 99))
(define-test "AC-14 arity is checked"
  (check-error (eval-all "[[1 to: 3] collect: (lambda () 1)]") "procedure: expected 0 arguments, got 1"))
(define-test "setup"
  (eval-all "(define (helper n) (* n 10)) (define (via-tail n) (helper n))"))
(define-test "AC-15 collect: with a tail-calling procedure"
  (check (array->list [[1 to: 3] collect: via-tail]) '(10 20 30)))
(define-test "setup (from a check that stays in the suite)"
  (guard (e (#t #f)) (eval-all "(define (cd n) (if (= n 0) (quote done) (cd (- n 1)))) (lambda (n) (cd n))")))
(define-test "AC-16 on:do: with LISP block and handler"
  (check (eval-all "[(lambda () (/ 1 0)) on: (smalltalk ZeroDivide) do: (lambda (e) (quote caught))]") 'caught))
(define-test "AC-16 the handler gets the exception"
  (check (eval-all "[(lambda () [3 frobnicate]) on: (smalltalk MessageNotUnderstood) do: (lambda (e) (lisp-symbol [[e message] selector]))]") 'frobnicate))
(define-test "AC-16 no error: the block's value"
  (check (eval-all "[(lambda () 7) on: (smalltalk Error) do: (lambda (e) 0)]") 7))
(define-test "AC-16 ensure: runs the cleanup"
  (check (eval-all "(define trail (list)) [(lambda () (set! trail (cons 1 trail))) ensure: (lambda () (set! trail (cons 2 trail)))] trail") '(2 1)))
(define-test "AC-19 an unknown message"
  (check-error (eval-all "[[OrderedCollection new] frobnicate]") "#<an OrderedCollection()> does not understand #frobnicate"))

(run-tests)
