# --- Pharo runtime -----------------------------------------------------------
# The VM + image live here. They are large (~60 MB) and fully regenerable with
# bootstrap-pharo.bat, so they do not belong in history.
/pharo/

# Loose Pharo image artifacts, in case any ever land outside /pharo/.
*.image
*.changes
*.sources

# Pharo writes this at the working directory on errors; it is transient.
PharoDebug.log
# The VM writes a minidump here when it aborts (e.g. at --maxOldSpaceSize).
crash.dmp

# --- Releases ----------------------------------------------------------------
# release/package.sh writes the bundles here.
/dist/

# --- Editor / tooling --------------------------------------------------------
# Workspace settings are shared (the .lisp association and the spelling
# dictionary); anything else VS Code writes there stays local.
/.vscode/*
!/.vscode/settings.json

# The VS Code extension's dev tools and its packaged .vsix are regenerable.
/vscode/node_modules/
/vscode/*.vsix
/vscode/*.vsix.version

# --- OS cruft ----------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
/vscode/.vscode-test/
